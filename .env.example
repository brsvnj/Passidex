# ---- Passidex environment ----
# Copy to .env and fill in. Never commit .env.

# Database (PostgreSQL, EU region for GDPR)
DATABASE_URL="postgresql://passidex:passidex@localhost:5432/passidex?schema=public"

# API
API_PORT=3001
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:5173"

# Frontend
VITE_API_URL="http://localhost:3001"

# --- The following are used from Phase 2+ (supplier requests / AI parsing) ---

# Transactional + inbound email (Postmark). Left blank until Phase 2.
POSTMARK_SERVER_TOKEN=""
# Base domain used to mint unique per-request reply-to addresses, e.g. inbound.passidex.eu
INBOUND_EMAIL_DOMAIN=""

# AI document parsing (Anthropic). Left blank until Phase 3.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Object storage (S3-compatible, EU region). Left blank until Phase 3.
S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET="passidex-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
