# ---- Passidex environment ----
# Copy to .env and fill in. Never commit .env.

# Database (PostgreSQL, EU region for GDPR)
DATABASE_URL="postgresql://passidex:passidex@localhost:5432/passidex?schema=public"

# API
API_PORT=3001
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:5173"

# Auth: secret for signing session JWTs (use a long random value in production).
JWT_SECRET="change-me-in-production"
# Session cookie lifetime.
JWT_EXPIRES="7d"
# Set true when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE="false"

# Frontend
VITE_API_URL="http://localhost:3001"

# GS1 Digital Link resolver domain used in exported passports (Phase 5).
GS1_RESOLVER_DOMAIN="id.passidex.eu"

# Public app URL used to build team-invitation links.
APP_URL="http://localhost:5173"

# --- Phase 2: supplier requests + reminders ---

# Transactional + inbound email (Postmark). When blank, emails are logged to the
# console instead of sent (dev fallback) — the request lifecycle still works.
POSTMARK_SERVER_TOKEN=""
# From address for outgoing supplier requests.
SENDER_EMAIL="noreply@passidex.eu"
# Base domain used to mint unique per-request reply-to addresses, e.g. inbound.passidex.eu
INBOUND_EMAIL_DOMAIN="inbound.passidex.eu"
# Reminder cadence: resend after this many days of no answer, up to MAX_REMINDERS times.
REMINDER_AFTER_DAYS="7"
MAX_REMINDERS="2"
# Cron for the reminder sweep (pg-boss). Default: hourly.
REMINDER_CRON="0 * * * *"

# --- Phase 3: inbound email + document ingestion + AI parsing ---

# Shared secret required as ?token= on the Postmark inbound webhook URL.
INBOUND_WEBHOOK_SECRET=""

# AI document parsing (Anthropic). When blank, inbound mail is stored but not parsed.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Object storage (S3-compatible, EU region). When S3_BUCKET/keys are blank,
# documents are written to UPLOAD_DIR on local disk (dev fallback).
UPLOAD_DIR="uploads"
S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
